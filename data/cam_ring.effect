// Zoominator webcam ring: shows the source as a circle with a solid ring and a
// soft glow around it. Used as a filter on the webcam source.
//
// size_px is the source size in pixels. The circle is centred in the source and
// shows the centre square of the picture (as tall as the source is high).

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 size_px;
uniform float radius_px;
uniform float border_px;
uniform float glow_px;
uniform float glow_strength;
uniform float4 ring_color;
uniform float hue;  // radians the rainbow ring is turned round the colour wheel (the animation)
uniform float flow; // 1 = rainbow: the spectrum instead of the chosen colour, turning round the ring

sampler_state textureSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertInOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

// A pure, fully bright colour from the colour wheel (red at 0, then yellow, green, cyan, blue, magenta), like the lights of
// an ARGB fan. It does not depend on any colour the user picked.
float3 spectrum(float a)
{
	float h = frac(a / 6.2831853);
	return saturate(abs(frac(h + float3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0);
}

float4 PSRing(VertInOut vert_in) : TARGET
{
	float2 p = vert_in.uv * size_px;
	float2 c = size_px * 0.5;

	// Negative inside the circle, positive outside.
	float d = length(p - c) - radius_px;

	// The circle shows the centre square of the picture.
	float k = min(size_px.x, size_px.y) / max(2.0 * radius_px, 1.0);
	float2 suv = (c + (p - c) * k) / size_px;
	float4 pic = image.Sample(textureSampler, suv);

	float inside = saturate(0.5 - d);
	float picA = inside * pic.a;

	float ringA = 0.0;
	if (border_px > 0.5)
		ringA = saturate(d + 0.5) * saturate(border_px - d + 0.5);
	if (glow_px > 0.5) {
		float g = saturate(1.0 - (d - border_px) / glow_px);
		float ga = glow_strength * g * g * saturate(d - border_px + 0.5);
		ringA = saturate(ringA + ga * (1.0 - ringA));
	}
	ringA *= (1.0 - inside);

	float outA = picA + ringA * (1.0 - picA);
	float h = hue;
	if (flow > 0.5)
		h += atan2(p.y - c.y, p.x - c.x);
	float3 rc = ring_color.rgb;
	if (flow > 0.5)
		rc = spectrum(h);
	float3 rgb = (pic.rgb * picA + rc * ringA * (1.0 - picA)) / max(outA, 0.0001);
	return float4(rgb, outA);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSRing(vert_in);
	}
}
