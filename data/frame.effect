// Zoominator frame: draws the area around a rectangle (the zoomed screen) as a
// solid background colour, with a glowing border along the rectangle's edges.
// The inside of the rectangle is left transparent so the content shows through.
//
// Everything is computed per pixel from a signed distance to a rounded
// rectangle, so the frame can follow the content every frame while it zooms and
// pans, without rebuilding any image.
//
// All positions and sizes are in canvas pixels. rect_px = (left, top, right,
// bottom). The rectangle may extend past the canvas; edges that are off screen
// simply draw nothing.

uniform float4x4 ViewProj;

uniform float2 canvas_px;
uniform float4 rect_px;
uniform float4 tilt;     // yaw, pitch (radians), camera distance (px), sheet scale; distance 0 = flat
uniform float2 tilt_pivot; // canvas pixel the screen turns about
uniform float radius_px;
uniform float border_px;
uniform float glow_px;
uniform float glow_strength;
uniform float4 border_color;
uniform float4 bg_color;
uniform float4 bg_color2;
uniform float bg_mode;   // 0 solid, 1 linear, 2 radial
uniform float bg_angle;  // radians, linear only: 0 = left to right, pi/2 = top to bottom

struct VertInOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

float4 PSFrame(VertInOut vert_in) : TARGET
{
	float2 p = vert_in.uv * canvas_px;

	float2 center = float2(rect_px.x + rect_px.z, rect_px.y + rect_px.w) * 0.5;
	float2 half_size = float2(rect_px.z - rect_px.x, rect_px.w - rect_px.y) * 0.5;
	float r = min(radius_px, min(half_size.x, half_size.y));

	// 3D camera: look up where this pixel falls on the turned sheet (same maths as tilt3d.effect).
	float2 pl = p;
	if (tilt.z > 0.0) {
		float sa = sin(tilt.x);
		float ca = cos(tilt.x);
		float sb = sin(tilt.y);
		float cb = cos(tilt.y);
		float3 dir = float3((p - tilt_pivot) / tilt.w, tilt.z);
		float3 n = float3(cb * sa, -sb, cb * ca);
		float denom = dot(dir, n);
		if (denom < 0.0001) {
			pl = center + float2(100000.0, 100000.0);
		} else {
			float t = tilt.z * n.z / denom;
			float3 h = float3(t * dir.x, t * dir.y, -tilt.z + t * dir.z);
			float x1 = h.x * ca - h.z * sa;
			float z1 = h.x * sa + h.z * ca;
			float y2 = h.y * cb + z1 * sb;
			pl = tilt_pivot + float2(x1, y2);
		}
	}

	// Signed distance to the rounded rectangle: negative inside, positive outside.
	float2 q = abs(pl - center) - (half_size - float2(r, r));
	float d = length(max(q, float2(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - r;

	// Background colour and opacity (alpha 0 = see-through, 1 = solid).
	float3 col = bg_color.rgb;
	float alpha = bg_color.a;
	if (bg_mode > 0.5) {
		float2 cc = canvas_px * 0.5;
		float t;
		if (bg_mode < 1.5) {
			float2 dir = float2(cos(bg_angle), sin(bg_angle));
			float ext = abs(dir.x) * canvas_px.x + abs(dir.y) * canvas_px.y;
			t = saturate(dot(p - cc, dir) / max(ext, 1.0) + 0.5);
		} else {
			t = saturate(length(p - cc) / max(0.5 * length(canvas_px), 1.0));
		}
		col = lerp(bg_color.rgb, bg_color2.rgb, t);
		alpha = lerp(bg_color.a, bg_color2.a, t);
	}

	// Glow: fades out quadratically from the outer edge of the border. Drawn over the background, so it stays
	// visible even when the background is see-through.
	if (glow_px > 0.5) {
		float g = saturate(1.0 - (d - border_px) / glow_px);
		float ga = glow_strength * g * g * saturate(d - border_px + 0.5);
		float na = ga + alpha * (1.0 - ga);
		col = (border_color.rgb * ga + col * alpha * (1.0 - ga)) / max(na, 0.0001);
		alpha = na;
	}

	// Border ring, drawn over everything else.
	if (border_px > 0.5) {
		float bm = saturate(border_px - d + 0.5);
		float na = bm + alpha * (1.0 - bm);
		col = (border_color.rgb * bm + col * alpha * (1.0 - bm)) / max(na, 0.0001);
		alpha = na;
	}

	// The window itself is transparent, with a one pixel soft edge.
	float inside = saturate(0.5 - d);
	return float4(col, alpha * (1.0 - inside));
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSFrame(vert_in);
	}
}
