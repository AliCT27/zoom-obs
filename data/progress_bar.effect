// Zoominator progress bar: a thin rounded bar along the top or bottom edge of the video that fills up over the
// planned length of the video, on a faint track.
//
// All positions are in canvas pixels, origin top-left, like the scene items.

uniform float4x4 ViewProj;

uniform float2 canvas_px;
uniform float4 bar_rect;     // x, y, width, height of the whole bar
uniform float fill;          // 0..1 how much of the bar is filled
uniform float4 bar_color;
uniform float hue;           // radians the rainbow is turned round the colour wheel (the animation)
uniform float flow;          // 1 = rainbow: the spectrum instead of the chosen colour, moving along the bar

struct VertInOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

// A pure, fully bright colour from the colour wheel (red at 0, then yellow, green, cyan, blue, magenta), like the lights of
// an ARGB fan. Same function as in frame.effect and cam_ring.effect.
float3 spectrum(float a)
{
	float h = frac(a / 6.2831853);
	return saturate(abs(frac(h + float3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0);
}

float4 PSBar(VertInOut vert_in) : TARGET
{
	float2 p = vert_in.uv * canvas_px;
	float2 half_size = bar_rect.zw * 0.5;
	float2 c = bar_rect.xy + half_size;
	float r = half_size.y; // fully rounded ends

	// Signed distance to the rounded bar: negative inside.
	float2 q = abs(p - c) - (half_size - r);
	float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
	float inside = saturate(0.5 - d);
	if (inside <= 0.0)
		return float4(0.0, 0.0, 0.0, 0.0);

	// The filled part ends at fill_x, with a soft edge one pixel wide.
	float fill_x = bar_rect.x + bar_rect.z * saturate(fill);
	float f = saturate(fill_x - p.x + 0.5) * inside;

	float3 col = bar_color.rgb;
	if (flow > 0.5)
		col = spectrum(6.2831853 * (p.x - bar_rect.x) / max(bar_rect.z, 1.0) - hue);

	// Track: faint white. Fill: the colour, on top of it.
	float track_a = 0.22 * inside;
	float a = f + track_a * (1.0 - f);
	float3 rgb = (col * f + float3(1.0, 1.0, 1.0) * track_a * (1.0 - f)) / max(a, 0.0001);
	return float4(rgb, a);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSBar(vert_in);
	}
}
