// Zoominator dots overlay: a video filter that plays a "dots" effect on top of the live picture, once, when it is
// started (hotkey or button). The picture is covered by a grid of round dots, then the dots give way again to the
// clean live picture. Whatever is on screen at the moment the dots are fully there is what shows afterwards, so it
// hides a cut.
//
// There are two waves over the same grid. The cover wave (progress 0 .. 0.68) runs from one side to the other; the
// reveal wave (progress 0.78 .. 1) runs back the opposite way. In between everything is covered for a moment.
// Stages of one cell, on its local cover progress lt (0..1):
//   0.05-0.30  a few cells pop up a coloured accent dot (blue, red, orange, teal)
//   0.28-0.55  every cell gets a pastel dot (its picture colour, washed out) and the picture fades behind it
//   0.55-0.85  the pastel dots take the true picture colour, the accents leave
// and on its local reveal progress lr (0..1):
//   0.00-0.50  the dots grow together into a mosaic of the picture
//   0.40-1.00  the mosaic gives way to the clean picture
// The layered style does the same with flat single-colour dots, see the branch in PSDots.
// At progress = 0 and at progress = 1 the output is exactly the input picture.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float progress;      // 0..1, the animation
uniform float2 size_px;      // source size in pixels
uniform float cell_px;       // grid cell size in pixels
uniform float dot_scale;     // dot diameter as a fraction of the cell
uniform float2 wave_dir;     // unit vector the cover wave travels along (pixels, y down); zero = from the centre
uniform float2 wave_dir_out; // the same for the reveal wave; the cells it reaches first leave first
uniform float wave_soft;     // width of the wave front as a fraction of the sweep
uniform float jitter;        // random shift of each cell's timing, fraction of the sweep
uniform float accent;        // 0..1, how many cells show a coloured accent dot (pastel style)
uniform float style;         // 0 = pastel, 1 = layered, 2 = single band
uniform float4 color0;       // layered: wave colours, first dots to show
uniform float4 color1;       //   (blue, dark red, orange)
uniform float4 color2;
uniform float4 color3;       // layered: colour the covered picture settles on (peach)
uniform float4 color4;       // layered: colour map for the new picture, dark parts
uniform float4 color5;       //   mid tones
uniform float4 color6;       //   light parts

sampler_state tex_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData vert_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv = vert_in.uv;
	return vert_out;
}

float hash21(float2 p)
{
	p = frac(p * float2(123.34, 456.21));
	p += dot(p, p + 45.32);
	return frac(p.x * p.y);
}

float2 hash22(float2 p)
{
	float h = hash21(p);
	return float2(h, hash21(p + h * 17.17 + 3.31));
}

// Place of a cell in a straight sweep along dir (0 = reached first, 1 = last). Zero dir: a ring spreading from the centre.
float front_lin(float2 cc, float2 dir)
{
	float ext = 0.5 * (abs(dir.x) * size_px.x + abs(dir.y) * size_px.y);
	if (ext < 1.0)
		return saturate(length(cc - 0.5 * size_px) / max(0.5 * length(size_px), 1.0));
	return dot(cc - 0.5 * size_px, dir) / ext * 0.5 + 0.5;
}

// The same for curved fronts: circles around a point just outside the frame on the side the sweep starts from.
float front_circ(float2 cc, float2 dir)
{
	float ext = 0.5 * (abs(dir.x) * size_px.x + abs(dir.y) * size_px.y);
	float2 org = 0.5 * size_px - dir * ext * 1.05;
	float gmax = max(max(length(org), length(org - float2(size_px.x, 0.0))),
			 max(length(org - float2(0.0, size_px.y)), length(org - size_px)));
	return saturate(length(cc - org) / max(gmax, 1.0));
}

// Layered style: colour of a dot while the picture is being covered, from its local cover progress lt (0..1).
// White -> first colour -> hot colour (red, orange towards the far edge) -> peach. A few cells keep a colour.
float3 cover_colour(float lt, float g, float2 h)
{
	float3 hot = lerp(color1.rgb, color2.rgb, smoothstep(0.55, 0.95, g));
	float3 c = float3(1.0, 1.0, 1.0);
	c = (lt > 0.08) ? color0.rgb : c;
	c = (lt > 0.30) ? hot : c;
	c = (lt > 0.55) ? color3.rgb : c;
	// leftovers that stay behind in the peach field
	c = (lt > 0.55 && h.x > 0.90) ? hot : c;
	c = (lt > 0.55 && h.x < 0.05) ? color0.rgb : c;
	return c;
}

// Colour map for the new picture: dark -> mid -> light by luminance.
float3 map_colour(float lum)
{
	return lerp(lerp(color4.rgb, color5.rgb, smoothstep(0.30, 0.38, lum)), color6.rgb, smoothstep(0.62, 0.70, lum));
}

float4 PSDots(VertData vert_in) : TARGET
{
	float4 src = image.Sample(tex_sampler, vert_in.uv);
	if (progress <= 0.0 || progress >= 1.0)
		return src;

	float2 pix = vert_in.uv * size_px;
	float2 cell = floor(pix / cell_px);
	float2 cc = (cell + 0.5) * cell_px;
	float2 cuv = min(cc / size_px, float2(1.0, 1.0));

	// Place of this cell in the sweep (0 = first, 1 = last), shifted a little at random.
	float gb = front_lin(cc, wave_dir);
	float gb_out = front_lin(cc, wave_dir_out);
	float2 h = hash22(cell);
	float jit = (h.x - 0.5) * jitter;
	float g_cover = saturate(gb + jit);
	float g_reveal = saturate(gb_out + jit);
	float soft = max(wave_soft, 0.02);
	float t_cover = saturate(progress / 0.68);
	float t_reveal = saturate((progress - 0.78) / 0.22);
	float lt = saturate((t_cover * (1.0 + soft) - g_cover) / soft);
	float lr = saturate((t_reveal * (1.0 + soft) - g_reveal) / soft);

	float s_acc_in = smoothstep(0.05, 0.30, lt);
	float s_acc_out = smoothstep(0.60, 0.85, lt);
	float s_pas = smoothstep(0.28, 0.55, lt);
	float s_true = smoothstep(0.55, 0.85, lt);
	float s_grow = smoothstep(0.00, 0.50, lr);
	float s_end = smoothstep(0.40, 1.00, lr);

	float d = length(pix - cc);
	float r_dot = cell_px * 0.5 * dot_scale;
	float r_full = cell_px * 0.80;

	if (style > 1.5) {
		// Single band: one layer of flat dots of one colour that travels across the picture once. The dots grow at
		// the front of the band and shrink away behind it, so the picture is never covered completely and is
		// plain again as soon as the band has passed.
		float gq = saturate(front_circ(cc, wave_dir) + jit * 0.35);
		float lq = saturate((progress * (1.0 + soft) - gq) / soft);
		float grow = smoothstep(0.0, 0.30, lq);
		float vanish = smoothstep(0.55, 1.00, lq);
		float pop2 = 1.0 + 0.20 * sin(3.14159265 * saturate(lq / 0.30));
		float rq = r_dot * grow * (1.0 - vanish) * pop2;
		// A light tint under the band, worked out per pixel (not per cell) so it does not show square tiles.
		float lp = saturate((progress * (1.0 + soft) - front_circ(pix, wave_dir)) / soft);
		float fq = smoothstep(0.05, 0.30, lp) * (1.0 - smoothstep(0.55, 0.95, lp));
		float3 colq = lerp(src.rgb, float3(0.92, 0.92, 0.92), 0.35 * fq);
		float mq = saturate(rq - d + 0.5) * step(0.001, rq);
		colq = lerp(colq, color0.rgb, mq);
		return float4(saturate(colq), src.a);
	}

	if (style > 0.5) {
		// Flat dots of one colour each on a light grey field. The cover wave spreads from a point above the frame
		// in curved fronts, a few cells running ahead of it. Then the reveal wave starts from the chosen side:
		// the dots take a colour from the brightness of the live picture, grow into a mosaic of the picture and
		// give way to the sharp picture.
		float go = front_circ(cc, wave_dir);
		float go_out = front_circ(cc, wave_dir_out);
		float pioneer = step(h.x, 0.25) * h.y;
		float gc = saturate(go + jit * 0.35 - pioneer * 0.30);
		float gr = saturate(go_out + jit * 0.35);
		float tcv = saturate(progress / 0.55);
		float trv = saturate((progress - 0.68) / 0.32);
		float lc = saturate((tcv * (1.0 + soft) - gc) / soft);
		float lrv = saturate((trv * (1.0 + soft) - gr) / soft);

		float s_bg = smoothstep(0.0, 0.08, lc);
		float3 pic2 = image.Sample(tex_sampler, cuv).rgb;
		float lum = dot(pic2, float3(0.299, 0.587, 0.114));
		float3 field = lerp(float3(0.92, 0.92, 0.92), color6.rgb, 0.25 * smoothstep(0.0, 0.3, lrv));

		float3 dc = cover_colour(lc, go, h);
		dc = lerp(dc, map_colour(lum), smoothstep(0.0, 0.2, lrv));
		dc = lerp(dc, pic2, smoothstep(0.30, 0.65, lrv));
		float r2 = lerp(r_dot, r_full, smoothstep(0.30, 0.65, lrv));

		float3 col2 = lerp(src.rgb, field, s_bg);
		float m2 = saturate(r2 - d + 0.5) * s_bg;
		col2 = lerp(col2, dc, m2);
		col2 = lerp(col2, src.rgb, smoothstep(0.60, 1.00, lrv));
		return float4(saturate(col2), src.a);
	}

	// Colour of the picture at the cell centre, washed out towards a warm pastel for the middle of the effect.
	float3 pic = image.Sample(tex_sampler, cuv).rgb;
	float luma = dot(pic, float3(0.299, 0.587, 0.114));
	float3 pastel = lerp(float3(luma, luma, luma), pic, 0.55);
	float3 tint = lerp(float3(0.97, 0.78, 0.68), float3(0.93, 0.68, 0.80), h.y);   // peach .. pink, per cell
	pastel = lerp(pastel, tint, 0.62);
	pastel = lerp(pastel, float3(1.0, 1.0, 1.0), 0.10);
	float3 dot_col = lerp(pastel, pic, s_true);

	// Pastel dot: grows from nothing while its cell is coming in, then fills the cell in the mosaic stage.
	float r_pas = lerp(0.0, r_dot, s_pas);
	r_pas = lerp(r_pas, r_full, s_grow);
	float m_pas = saturate(r_pas - d + 0.5);

	// Light, slightly warm filler between the dots while the picture is covered.
	float cover = s_pas * (1.0 - s_end);
	float3 filler = lerp(pic, float3(0.95, 0.92, 0.92), 0.85);
	float3 base = lerp(src.rgb, filler, cover * 0.95);
	float3 col = lerp(base, dot_col, m_pas);

	// Coloured accent dot on a random subset of the cells.
	float pick = h.y;
	float3 acc_col = (pick < 0.25) ? float3(0.36, 0.76, 0.95)
			: (pick < 0.55) ? float3(0.74, 0.14, 0.08)
			: (pick < 0.80) ? float3(0.96, 0.46, 0.16)
					: float3(0.12, 0.62, 0.52);
	float has_acc = step(h.x, 0.18 + 0.65 * accent) * step(0.001, accent);
	float acc_on = has_acc * s_acc_in * (1.0 - s_acc_out);
	// A little pop: the accent dot overshoots its size on the way in.
	float pop = 1.0 + 0.25 * sin(3.14159265 * saturate(lt / 0.30));
	float m_acc = saturate(r_dot * pop - d + 0.5);
	col = lerp(col, acc_col, m_acc * acc_on);

	// The mosaic gives way to the clean picture; a tiny white dot lingers for a moment at the very end.
	col = lerp(col, src.rgb, s_end);
	float spark_on = (1.0 - smoothstep(0.80, 1.0, lr)) * smoothstep(0.30, 0.60, lr) * step(0.55, h.x);
	float m_sp = saturate(cell_px * 0.10 - d + 0.5);
	col = lerp(col, float3(1.0, 1.0, 1.0), m_sp * spark_on * 0.55);

	return float4(saturate(col), src.a);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDots(vert_in);
	}
}
